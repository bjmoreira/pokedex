# EN: Application / PT: Aplicação
APP_NAME=Pokedex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# EN: Logs to stderr so `docker compose logs` shows everything.
# PT: Logs em stderr para que `docker compose logs` mostre tudo.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# EN: Database (MySQL service in docker-compose) / PT: Banco (serviço MySQL no docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pokedex
DB_USERNAME=pokedex
DB_PASSWORD=pokedex

# EN: Drivers / PT: Drivers
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# EN: PokeAPI upstream / PT: PokeAPI externa
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_CACHE_TTL=86400

# EN: Allowed CORS origins for the frontend dev server / PT: Origens CORS do dev server
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
